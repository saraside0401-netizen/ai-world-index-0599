{
  "name": "sandbox-app-template",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && npx vite",
    "dev:desktop": "cd packages/desktop && npx vite",
    "dev:mobile": "cd packages/mobile && npx expo start --port $(node -e \"console.log(require('./__ports.cjs').mobile)\")",
    "build": "npm run build:web",
    "build:web": "cd packages/web && npx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app 2>/dev/null || true",
    "kill:port": "npm run internal:kill-port",
    "lint": "runkit lint",
    "lint:fix": "runkit lint --fix",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "internal:kill-port": "lsof -t -i :$(node -e \"console.log(require('./__ports.cjs').website)\") | xargs kill -9"
  },
  "devDependencies": {
    "@runablehq/runkit": "0.1.1",
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
